#!/usr/bin/env python3
# dotfiles-completion: begin
# commands: vibrance
# body:
#   _arguments '1:value:(0 1)'
# dotfiles-completion: end

import re
import subprocess
import sys


def run_nvidia_settings(*args):
    return subprocess.run(
        ["nvidia-settings", *args],
        capture_output=True,
        text=True,
        check=True,
    )


def get_info():
    result = run_nvidia_settings("-q", "DigitalVibrance")
    output = result.stdout

    value = int(
        re.search(r"Attribute 'DigitalVibrance'.*?:\s*(-?\d+)\.", output).group(1)
    )

    lo, hi = map(
        int,
        re.search(
            r"range\s+(-?\d+)\s*-\s*(-?\d+)",
            output,
            re.IGNORECASE,
        ).groups(),
    )

    return value, lo, hi


def set_vibrance(level):
    if not (-1.0 <= level <= 1.0):
        raise ValueError("Value must be between -1.0 and 1.0.")

    _, lo, hi = get_info()

    # Map [-1, 1] -> [lo, hi]
    value = round(lo + ((level + 1.0) / 2.0) * (hi - lo))

    run_nvidia_settings("-a", f"DigitalVibrance={value}")

    return value


def main():
    if len(sys.argv) == 1:
        value, _, _ = get_info()
        print('Current vibrance value:', value)
    elif len(sys.argv) == 2:
        try:
            level = float(sys.argv[1])
            print('Vibrance set to:', set_vibrance(level))
        except ValueError as e:
            print(e, file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Usage: {sys.argv[0]} [-1.0..1.0]", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
